# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key-aqui

# Necessário apenas para o script de importação de imagens (scripts/import-cromos.ts)
# Supabase → Project Settings → API → service_role (secret) — NÃO exponha no cliente
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
